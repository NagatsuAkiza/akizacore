# Salin ke .env lalu isi. JANGAN commit .env.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=isi_token_bot_dev
# ID Discord pemilik bot; bypass quota, cooldown, dan permission fitur admin
OWNER_USER_ID=user_id_discord
# ID server untuk testing: slash command sync instan (kosongkan untuk global)
DEV_GUILD_ID=

# PostgreSQL (docker compose up -d)
DATABASE_URL=postgresql+asyncpg://akiza:akiza@localhost:5432/akizacore

# --- AI provider (format OpenAI-compatible) ---
# Contoh base URL (cek dokumen penyedia untuk nama model terbaru dan batas free tier):
#   Groq       : https://api.groq.com/openai/v1
#   OpenRouter : https://openrouter.ai/api/v1
#   Gemini     : https://generativelanguage.googleapis.com/v1beta/openai/
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_FAST=
AI_MODEL_SMART=
# Parameter tambahan request (JSON, tulis dalam tanda kutip tunggal), contoh:
#   AI_EXTRA_BODY='{"reasoning_effort":"low"}'
AI_EXTRA_BODY=
# Provider cadangan (opsional): dipakai bila provider utama gagal
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_EXTRA_BODY=

# --- Batas dan biaya AI (nilai default) ---
AI_COST_COINS=5
AI_COOLDOWN_S=10
AI_DAILY_GLOBAL_LIMIT=100
AI_DAILY_USER_LIMIT=15
AI_HISTORY_MESSAGES=6
AI_MAX_INPUT_CHARS=1500
AI_MAX_OUTPUT_TOKENS=1024
QUOTA_UTC_OFFSET_HOURS=7
AI_TOOLS_ENABLED=true
AI_MAX_TOOL_ROUNDS=3
AI_RETENTION_DAYS=30
AI_USAGE_RETENTION_DAYS=90
ECONOMY_STARTER_BALANCE=100
ECONOMY_DAILY_AMOUNT=50
ECONOMY_DAILY_XP=20
ECONOMY_WORK_MIN=15
ECONOMY_WORK_MAX=45
ECONOMY_WORK_COOLDOWN_S=3600
ECONOMY_WORK_XP=10
ECONOMY_TRANSFER_DAILY_LIMIT=500
ECONOMY_TRANSFER_MIN_ACCOUNT_AGE_DAYS=7
ECONOMY_MESSAGE_XP_MIN=5
ECONOMY_MESSAGE_XP_MAX=15
ECONOMY_MESSAGE_XP_COOLDOWN_S=60

# --- API dashboard (Fase 6) ---
# Origin dashboard yang boleh memanggil API (daftar JSON, tanpa "*").
DASHBOARD_ORIGINS=["http://localhost:5173"]

# --- Discord OAuth2 (Fase 6a-2) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/discord/callback
SESSION_TTL_S=604800
DASHBOARD_URL=http://localhost:5173
GUILD_CACHE_TTL_S=60

