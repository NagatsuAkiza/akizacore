# Salin ke .env lalu isi. JANGAN commit .env.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=isi_token_bot_dev
# ID server untuk testing: slash command sync instan (kosongkan untuk global)
DEV_GUILD_ID=

# PostgreSQL (docker compose up -d)
DATABASE_URL=postgresql+asyncpg://akiza:akiza@localhost:5432/akizacore

# --- AI provider (format OpenAI-compatible) ---
# Contoh base URL (cek dokumen penyedia untuk nama model terbaru dan batas free tier):
#   Groq       : https://api.groq.com/openai/v1
#   OpenRouter : https://openrouter.ai/api/v1
#   Gemini     : https://generativelanguage.googleapis.com/v1beta/openai/
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_FAST=
AI_MODEL_SMART=
# Provider cadangan (opsional): dipakai bila provider utama gagal
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# --- Batas dan biaya AI (nilai default) ---
AI_COST_COINS=5
AI_COOLDOWN_S=10
AI_DAILY_GLOBAL_LIMIT=500
AI_DAILY_USER_LIMIT=30
AI_HISTORY_MESSAGES=10
AI_MAX_INPUT_CHARS=1500
AI_MAX_OUTPUT_TOKENS=600
QUOTA_UTC_OFFSET_HOURS=7
ECONOMY_STARTER_BALANCE=100