# Salin ke .env lalu isi. JANGAN commit .env.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=isi_token_bot_dev
# ID server untuk testing: slash command sync instan (kosongkan untuk global)
DEV_GUILD_ID=

# Fase 2: PostgreSQL (docker compose up -d)
DATABASE_URL=postgresql+asyncpg://akiza:akiza@localhost:5432/akizacore

# Fase 3: AI provider (OpenAI-compatible: Groq / Gemini / OpenRouter)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_FAST=
AI_MODEL_SMART=